{
  "name": "gmsgs",
  "productName": "Google Messages", 
  "version": "1.1.0",
  "description": "Desktop wrapper for messages.google.com",
  "main": "src/main.js",
  "homepage": "https://messages.google.com/web",
  "scripts": {
    "start": "electron . --ozone-platform=x11",
    "dist": "electron-builder --linux deb"
  },
  "build": {
    "appId": "com.gmsgs.app",
    "productName": "Google Messages",
    "icon": "src/assets/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": "deb",
      "category": "Network"
    }
  },
  "keywords": [],
  "author": {
    "name": "Sharath Kumar Pichika",
    "email": "sharath.k2693@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0"
  }
}

